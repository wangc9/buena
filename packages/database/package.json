{
  "name": "@cw/database",
  "version": "1.0.0",
  "author": "Chen Wang",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "kysely": "^0.28.9",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@cw/typescript-config": "*",
    "@types/pg": "^8.16.0",
    "kysely-codegen": "^0.19.0",
    "kysely-ctl": "^0.19.0",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/kysely.d.ts",
      "default": "./dist/kysely.js"
    },
    "./kysely": {
      "types": "./dist/kysely.d.ts",
      "default": "./dist/kysely.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    }
  },
  "main": "./dist/kysely.js",
  "types": "./dist/kysely.d.ts",
  "scripts": {
    "build": "tsc --outDir dist",
    "dev": "tsc --watch",
    "migrate:make": "kysely migrate:make",
    "migrate:up": "kysely migrate:up",
    "migrate:down": "kysely migrate:down",
    "codegen": "kysely-codegen --out-file ./src/db.ts"
  }
}
